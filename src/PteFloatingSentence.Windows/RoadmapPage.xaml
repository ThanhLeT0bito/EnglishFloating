<UserControl x:Class="PteFloatingSentence.Windows.RoadmapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFE2E8F0">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="CardSubtleBrush" Color="#FF161F30" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF334155" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1D4ED8" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Same look as the other pages: rounded corners, hover, pressed and disabled states. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Foreground" Value="#FFD8E2F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2B3A52" />
                    <Setter Property="BorderBrush" Value="#FF3B82F6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small rounded chip for topics and exercises. -->
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== Session summary (after today's session) ===== -->
        <Border x:Name="SummaryCard" Background="#1A34D399" BorderBrush="#8034D399" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE930;" FontSize="16" Foreground="#FF34D399" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryTextBlock" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SummaryStreakText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CloseSummaryButton" Grid.Column="2" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="10,0,0,0"
                        VerticalAlignment="Center" Click="CloseSummaryButton_Click" />
            </Grid>
        </Border>

        <!-- ===== Today ===== -->
        <Border x:Name="TodayCard" Background="#1A2563EB" BorderBrush="#663B82F6" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TodayTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StreakTextBlock" FontSize="12" Foreground="#FF93C5FD" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="StartSessionButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                            ToolTip="Review, learn, drill and apply, one step after another" Click="StartSessionButton_Click" />
                </Grid>
                <StackPanel x:Name="TodayPlanPanel" Margin="0,12,0,0" />
                <TextBlock x:Name="TodayEmptyText" FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           Text="Every available stage is done. Keep practicing on the Writing page while paragraphs and PTE tasks are being built." />
            </StackPanel>
        </Border>

        <!-- ===== Path ===== -->
        <TextBlock Text="Your path" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,2" />
        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="2,0,0,12"
                   Text="Writing and grammar from simple sentences to PTE tasks. A stage is done when each lesson's quick check is passed, two thirds of its topics pass a drill, and your last 15 sentences in the stage average 75 or more with no grammar that needs review." />
        <StackPanel x:Name="StagesPanel" />
    </StackPanel>
</UserControl>
