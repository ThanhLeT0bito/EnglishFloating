<Window x:Class="PteFloatingSentence.Windows.SentencePhrasingReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review reading groups" Width="800" Height="610" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False"
        Background="#0B1120" Foreground="#E2E8F0" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Review before adding" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Check any corrections. Each line below becomes one reading group." Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="YOUR ORIGINAL" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,8" />
                        <Border Background="#111827" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="14">
                            <TextBlock x:Name="OriginalText" FontSize="16" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AI PROPOSAL · EDITABLE" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,8" />
                        <TextBox x:Name="GroupsInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto" IsEnabled="False" TextChanged="GroupsInput_TextChanged" />
                        <TextBlock x:Name="CorrectionNote" Foreground="#FBBF24" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="FLOATING PREVIEW" Foreground="#94A3B8" FontSize="11" Margin="0,24,0,8" />
                <Border BorderBrush="#5EEAD4" BorderThickness="1" Background="#122338" CornerRadius="10" Padding="18">
                    <TextBlock x:Name="PreviewText" FontSize="21" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,14,0,14" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Background="#334155" Margin="0,0,10,0" />
            <Button x:Name="ConfirmButton" Content="Confirm &amp; add" IsEnabled="False" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
