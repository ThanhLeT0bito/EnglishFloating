<UserControl x:Class="PteFloatingSentence.Windows.FlashcardsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PteFloatingSentence.Windows"
             Foreground="#FFE2E8F0"
             Focusable="True"
             KeyDown="UserControl_KeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="CardSubtleBrush" Color="#FF161F30" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF263449" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1D4ED8" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFDC2626" />
        <SolidColorBrush x:Key="HardBrush" Color="#FFD97706" />
        <SolidColorBrush x:Key="RememberedBrush" Color="#FF16A34A" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SecondarySmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#FF263449" />
            <Setter Property="Foreground" Value="#FFD8E2F0" />
        </Style>

        <Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#FF7F1D2D" />
            <Setter Property="Foreground" Value="#FFFCA5A5" />
        </Style>

        <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FF263449" />
            <Setter Property="Foreground" Value="#FFD8E2F0" />
            <Setter Property="BorderBrush" Value="#FF475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1D4ED8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- NORMAL DECK MANAGEMENT VIEW -->
        <Grid x:Name="DeckManagementView" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Deck Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Decks" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Study list and custom flashcards" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <ListBox x:Name="DecksListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="DecksListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardSubtleBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#2238BDF8" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TypeBadge}" FontSize="10" Foreground="#FF38BDF8" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- New Custom Deck Button -->
                    <Button x:Name="NewDeckButton"
                            Grid.Row="2"
                            Style="{StaticResource SmallButtonStyle}"
                            Content="+ New Custom Deck"
                            Margin="0,8,0,0"
                            Click="NewDeckButton_Click" />
                </Grid>
            </Border>

            <!-- Right: Deck Content -->
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Deck Header & Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedDeckNameText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Select a deck" />
                                <Border x:Name="SelectedDeckBadge" Background="#2238BDF8" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="SelectedDeckBadgeText" FontSize="11" Foreground="#FF38BDF8" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SelectedDeckStatsText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="StartStudyingButton" Style="{StaticResource SmallButtonStyle}" Content="Start Studying" Margin="0,0,8,0" Click="StartStudyingButton_Click" />
                            <Button x:Name="AddCardButton" Style="{StaticResource SecondarySmallButtonStyle}" Content="+ Add Card" Margin="0,0,8,0" Click="AddCardButton_Click" Visibility="Collapsed" />
                            <Button x:Name="DeleteDeckButton" Style="{StaticResource DangerSmallButtonStyle}" Content="Delete Deck" Click="DeleteDeckButton_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Search / Filter -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="PhraseSearchBox"
                                 Padding="8,6"
                                 Background="#FF1E293B"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource InputBorderBrush}"
                                 Text=""
                                 TextChanged="PhraseSearchBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholderText"
                                   Text="Search cards by phrase..."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   IsHitTestVisible="False"
                                   Margin="10,7,0,0" />
                    </Grid>

                    <!-- Empty state message -->
                    <Border x:Name="EmptyDeckNotice" Grid.Row="2" Background="{StaticResource CardSubtleBrush}" CornerRadius="8" Padding="20" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyDeckNoticeText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
                    </Border>

                    <!-- Cards List -->
                    <ScrollViewer x:Name="CardsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CardsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardSubtleBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Card Info -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Phrase}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding PronunciationIpa}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Meaning}" FontSize="13" Foreground="#FF60A5FA" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Example}" FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SourceInfo}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- State & Actions -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Background="#FF1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StateBrush}" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource SecondarySmallButtonStyle}" Content="Edit" Padding="6,2" FontSize="11" Tag="{Binding CustomCardId}" Click="EditCardButton_Click" Margin="0,0,4,0" />
                                                    <Button Style="{StaticResource DangerSmallButtonStyle}" Content="Delete" Padding="6,2" FontSize="11" Tag="{Binding CustomCardId}" Click="DeleteCardButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- IN-PAGE STUDY VIEW -->
        <Grid x:Name="InPageStudyView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Study Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StudyDeckTitleText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Studying Deck" />
                    <TextBlock x:Name="StudyProgressText" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="12,2,0,0" Text="Card 1 / 10" />
                    <Border x:Name="StudyStateBadge" Background="#FF1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="StudyStateBadgeText" Text="New" FontSize="11" FontWeight="SemiBold" Foreground="#FF38BDF8" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" x:Name="ExitStudyButton" Style="{StaticResource SecondarySmallButtonStyle}" Content="Exit Study (Esc)" Click="ExitStudyButton_Click" />
            </Grid>

            <!-- Large Study Card -->
            <Border Grid.Row="1"
                    x:Name="StudyCardSurface"
                    Background="{StaticResource CardSubtleBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="500"
                    MinHeight="260"
                    MouseLeftButtonUp="StudyCardSurface_MouseLeftButtonUp">
                <Grid>
                    <!-- Front -->
                    <StackPanel x:Name="StudyFrontPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="StudyFrontPhraseText"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StudyFrontPronunciationText"
                                   FontSize="15"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Click or press Space to flip"
                                   FontSize="12"
                                   Foreground="#FF64748B"
                                   TextAlignment="Center"
                                   Margin="0,16,0,0" />
                    </StackPanel>

                    <!-- Back -->
                    <ScrollViewer x:Name="StudyBackPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StudyBackPhraseText"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="StudyBackPronunciationText"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,8" />
                            <TextBlock x:Name="StudyBackMeaningText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FF60A5FA"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="StudyBackExampleText"
                                       FontSize="14"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <Expander x:Name="StudySourceExpander" Header="Source Sentences" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Visibility="Collapsed">
                                <ItemsControl x:Name="StudySourceList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="4,2,0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Study Footer Navigation & Ratings -->
            <Grid Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StudyPrevButton" Style="{StaticResource SecondarySmallButtonStyle}" Content="◀ Prev" Margin="0,0,12,0" Click="StudyPrevButton_Click" />
                    <Button x:Name="StudyAgainButton" Style="{StaticResource SmallButtonStyle}" Background="{StaticResource DangerBrush}" Content="Again (1)" Margin="0,0,6,0" IsEnabled="False" Click="StudyAgainButton_Click" />
                    <Button x:Name="StudyHardButton" Style="{StaticResource SmallButtonStyle}" Background="{StaticResource HardBrush}" Content="Hard (2)" Margin="0,0,6,0" IsEnabled="False" Click="StudyHardButton_Click" />
                    <Button x:Name="StudyRememberedButton" Style="{StaticResource SmallButtonStyle}" Background="{StaticResource RememberedBrush}" Content="Remembered (3)" Margin="0,0,12,0" IsEnabled="False" Click="StudyRememberedButton_Click" />
                    <Button x:Name="StudyNextButton" Style="{StaticResource SecondarySmallButtonStyle}" Content="Next ▶" Click="StudyNextButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- DIALOG OVERLAY (New Deck / Add Card / Edit Card) -->
        <Border x:Name="DialogOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitleText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                    <!-- Deck Name Form -->
                    <StackPanel x:Name="DeckFormPanel" Visibility="Collapsed">
                        <TextBlock Text="Deck Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="DeckNameInput" />
                    </StackPanel>

                    <!-- Card Form -->
                    <StackPanel x:Name="CardFormPanel" Visibility="Collapsed">
                        <TextBlock Text="Phrase" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="CardPhraseInput" Margin="0,0,0,8" />

                        <TextBlock Text="Pronunciation (IPA, optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="CardPronunciationInput" Margin="0,0,0,8" />

                        <TextBlock Text="Simple English Meaning" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="CardMeaningInput" Margin="0,0,0,8" />

                        <TextBlock Text="Example Sentence" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="CardExampleInput" Margin="0,0,0,8" AcceptsReturn="True" Height="60" />
                    </StackPanel>

                    <TextBlock x:Name="DialogErrorText" Foreground="#FFFCA5A5" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="DialogSaveButton" Style="{StaticResource SmallButtonStyle}" Content="Save" Margin="0,0,8,0" Click="DialogSaveButton_Click" />
                        <Button x:Name="DialogCancelButton" Style="{StaticResource SecondarySmallButtonStyle}" Content="Cancel" Click="DialogCancelButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
