<Window x:Class="PteFloatingSentence.Windows.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Settings" Click="SettingsMenuItem_Click" />
            <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <Style x:Key="CircleNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="#E6121722" />
            <Setter Property="BorderBrush" Value="#FF3B82F6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFBAE6FD" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBorder"
                                CornerRadius="999"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBorder" Property="Background" Value="#FF1E293B" />
                                <Setter TargetName="CircleBorder" Property="BorderBrush" Value="#FF5EEAD4" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CircleBorder" Property="Background" Value="#FF0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CircleBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="#33334155" />
            <Setter Property="Foreground" Value="#FF94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#44475569" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF334155" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#01000000">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PreviousButton"
                Grid.Column="0"
                Style="{StaticResource CircleNavButtonStyle}"
                Margin="6,0,8,0"
                VerticalAlignment="Center"
                Content="&#xE76B;"
                FontFamily="Segoe MDL2 Assets"
                Visibility="Hidden"
                Click="PreviousButton_Click" />
        <Border x:Name="SentenceCard"
                Grid.Column="1"
                Padding="2"
                CornerRadius="12"
                SizeChanged="SentenceCard_SizeChanged">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3B82F6" Offset="0" />
                    <GradientStop Color="#FF5EEAD4" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border x:Name="SentenceBackground" Padding="18,10" CornerRadius="10" Background="#E6121722">
                <StackPanel HorizontalAlignment="Center">
                    <RichTextBox x:Name="SentenceBox"
                                 MaxWidth="900"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Margin="0"
                                 Focusable="True"
                                 Cursor="IBeam"
                                 PreviewMouseLeftButtonUp="SentenceBox_PreviewMouseLeftButtonUp"
                                 MouseDoubleClick="SentenceBox_MouseDoubleClick">
                        <RichTextBox.Resources>
                            <Style TargetType="FlowDocument">
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="PagePadding" Value="0" />
                            </Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </RichTextBox.Resources>
                        <FlowDocument x:Name="SentenceDocument" TextAlignment="Center" PagePadding="0" />
                    </RichTextBox>
                    <TextBlock x:Name="ProgressText" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#FF9CA3AF" FontSize="12" />
                    <ItemsControl x:Name="VocabularyPanel" Margin="0,12,0,0" MaxWidth="900" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E61E293B" CornerRadius="8" Padding="12,10" Margin="0,4" BorderBrush="#3338BDF8" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Phrase}" FontWeight="Bold" FontSize="14" Foreground="#FF5EEAD4" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PronunciationIpa}" Margin="8,0,0,0" FontSize="12" Foreground="#FF94A3B8" FontStyle="Italic" VerticalAlignment="Center" Visibility="{Binding IpaVisibility}" />
                                                <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="11" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Visibility="{Binding StatusVisibility}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meaning}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" Foreground="#FFF1F5F9" Visibility="{Binding ContentVisibility}" />
                                            <TextBlock Text="{Binding Example}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#FF94A3B8" FontStyle="Italic" Visibility="{Binding ContentVisibility}" />
                                            <TextBlock Text="{Binding ErrorMessage}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#FFFCA5A5" Visibility="{Binding ErrorVisibility}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Button Content="Retry" Style="{StaticResource CardActionButtonStyle}" Visibility="{Binding RetryVisibility}" Click="RetryVocabularyButton_Click" Tag="{Binding ItemId}" Margin="0,0,6,0" />
                                            <Button Content="Hide" Style="{StaticResource CardActionButtonStyle}" Click="HideVocabularyButton_Click" Tag="{Binding ItemId}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Border>
        <Button x:Name="NextButton"
                Grid.Column="2"
                Style="{StaticResource CircleNavButtonStyle}"
                Margin="8,0,6,0"
                VerticalAlignment="Center"
                Content="&#xE76C;"
                FontFamily="Segoe MDL2 Assets"
                Visibility="Hidden"
                Click="NextButton_Click" />
    </Grid>
</Window>
