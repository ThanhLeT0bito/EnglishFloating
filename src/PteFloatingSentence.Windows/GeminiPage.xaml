<UserControl x:Class="PteFloatingSentence.Windows.GeminiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFE2E8F0">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="CardSubtleBrush" Color="#FF161F30" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF263449" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF7F1D2D" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,4,0,0">
        <Border Padding="18,16" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Gemini API integration" />
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" Text="Provide your Google Gemini API key for automated sentence vocabulary lookup and explanations. The key is stored securely with DPAPI." TextWrapping="Wrap" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="API Key" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#FFCBD5E1" />
                        <PasswordBox x:Name="ApiKeyInput" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <TextBlock x:Name="ApiKeyStatusLabel" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <Button x:Name="ClearApiKeyButton" Style="{StaticResource DangerButton}" Content="Clear key" Click="ClearApiKeyButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Background="#1A334155" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Note: Your key is protected on this machine and never transmitted to any third-party service other than Google Gemini API." TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
