<UserControl x:Class="PteFloatingSentence.Windows.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFE2E8F0">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="CardSubtleBrush" Color="#FF161F30" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF263449" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />

        <Style x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="#FF94A3B8"
                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF293548" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3B82F6" />
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFF8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3B82F6" />
                                <Setter TargetName="Arrow" Property="Fill" Value="#FF38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Style="{StaticResource ModernComboBoxToggleButton}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FF1E293B"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            CornerRadius="6"
                                            Margin="0,4,0,4"
                                            Padding="4">
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                      CanContentScroll="True"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF334155" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,4,0,0">
        <!-- Floating Overlay Display Card -->
        <Border Padding="18,16" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Overlay visibility" />
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" Text="Control which study layers float over your desktop during practice." TextWrapping="Wrap" />

                <!-- Sentence Overlay Section -->
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF38BDF8" Text="Sentence Overlay" Margin="0,0,0,8" />
                <CheckBox x:Name="ShowSentenceOverlayInput"
                          Content="Show sentence overlay"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="13"
                          Margin="0,0,0,10"
                          VerticalContentAlignment="Center"
                          Checked="OnPreferenceChanged"
                          Unchecked="OnPreferenceChanged" />

                <CheckBox x:Name="ShowVocabularyCardsInput"
                          Content="Enable vocabulary highlight &amp; cards"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="13"
                          Margin="20,0,0,16"
                          VerticalContentAlignment="Center"
                          Checked="OnPreferenceChanged"
                          Unchecked="OnPreferenceChanged" />

                <!-- Flashcard Overlay Section -->
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF38BDF8" Text="Flashcard Overlay" Margin="0,4,0,8" />
                <CheckBox x:Name="ShowFloatingFlashcardInput"
                          Content="Show floating flashcard"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="13"
                          Margin="0,0,0,10"
                          VerticalContentAlignment="Center"
                          Checked="OnPreferenceChanged"
                          Unchecked="OnPreferenceChanged" />

                <StackPanel x:Name="FloatingDeckSelectionPanel" Margin="20,0,0,18">
                    <TextBlock Text="Deck to display:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="FloatingDeckComboBox"
                              Width="300"
                              HorizontalAlignment="Left"
                              SelectionChanged="FloatingDeckComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TypeBadge}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Explanatory note -->
                <Border Background="#1A334155" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Text="Hiding all floating overlays leaves the launcher icon visible on screen to restore them or open settings." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Upcoming / Preview Settings Card -->
        <Border Padding="18,16" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Opacity="0.6">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Audio &amp; Pronunciation (Coming soon)" />
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,12" Text="Future options for automated text-to-speech pronunciation and speed controls." TextWrapping="Wrap" />
                <CheckBox Content="Pronounce new sentences automatically" IsEnabled="False" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                <CheckBox Content="Highlight words with audio playback" IsEnabled="False" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
