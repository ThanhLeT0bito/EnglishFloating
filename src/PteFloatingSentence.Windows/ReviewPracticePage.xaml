<UserControl x:Class="PteFloatingSentence.Windows.ReviewPracticePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFE2E8F0">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="CardSubtleBrush" Color="#FF161F30" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF263449" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1D4ED8" />

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF263449" />
            <Setter Property="Foreground" Value="#FFD8E2F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AudioButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="&#xE767;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1E293B" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Style -->
        <Style x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="#FF94A3B8"
                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF293548" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3B82F6" />
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFF8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3B82F6" />
                                <Setter TargetName="Arrow" Property="Fill" Value="#FF38BDF8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Arrow" Property="Fill" Value="#FF64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Style="{StaticResource ModernComboBoxToggleButton}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FF1E293B"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            CornerRadius="6"
                                            Margin="0,4,0,4"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.4" Color="Black" />
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                      CanContentScroll="True"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="32" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF334155" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Study List Selector, Practice Mode Selector, Progress, and Audio Playback -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Study list:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                <ComboBox x:Name="StudyListSelector" Width="200" SelectionChanged="StudyListSelector_SelectionChanged" Margin="0,0,16,0" />

                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                <ComboBox x:Name="PracticeModeSelector" Width="170" SelectionChanged="PracticeModeSelector_SelectionChanged">
                    <ComboBoxItem Content="Text hints" Tag="TextHints" />
                    <ComboBoxItem Content="Listen &amp; write" Tag="ListenAndWrite" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ProgressLabel" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#FF38BDF8" Text="Sentence 1 of 1" />
                <Button x:Name="AudioButton"
                        Style="{StaticResource AudioButtonStyle}"
                        Margin="8,0,0,0"
                        ToolTip="Play audio (TTS)"
                        Click="AudioButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Empty state when no study lists or sentences -->
        <TextBlock x:Name="ReviewEmptyStateLabel" Grid.Row="1" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,16,0,0" Text="No sentences available in this list to practice." TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- Practice Area -->
        <Grid x:Name="PracticeArea" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card containing Sentence Projection -->
            <Border Grid.Row="0" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,14">
                <WrapPanel x:Name="SentenceProjectionPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            </Border>

            <!-- Inline Feedback & Revealed Answer -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock x:Name="InlineErrorLabel" Foreground="#FFFCA5A5" FontSize="13" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,4" />
                <TextBlock x:Name="RevealedAnswerLabel" Foreground="#FF38BDF8" FontSize="13" Visibility="Collapsed" />
            </StackPanel>

            <!-- Controls: Check answer, Skip word, Show answer, Navigation -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="CheckAnswerButton" Content="Check answer" Padding="14,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0" Click="CheckAnswerButton_Click" />
                    <Button x:Name="SkipWordButton" Content="Skip word" Style="{StaticResource SecondaryButtonStyle}" Click="SkipWordButton_Click" />
                    <Button x:Name="ShowAnswerButton" Content="Show answer" Style="{StaticResource SecondaryButtonStyle}" Click="ShowAnswerButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PreviousSentenceButton" Content="Previous sentence" Style="{StaticResource SecondaryButtonStyle}" Click="PreviousSentenceButton_Click" />
                    <Button x:Name="NextSentenceButton" Content="Next sentence" Margin="0" Style="{StaticResource SecondaryButtonStyle}" Click="NextSentenceButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Completion Banner (visible when sentence or list completed) -->
            <Border x:Name="CompletionPanel" Grid.Row="3" Background="#26059669" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="8" Padding="14,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="CompletionStatusLabel" FontWeight="Bold" FontSize="13" Foreground="#FF34D399" Text="Sentence completed!" />
                        <TextBlock x:Name="CompletionSubtextLabel" Foreground="#FFD1FAE5" FontSize="12" Margin="0,2,0,0" Text="All hidden words answered correctly." />
                    </StackPanel>
                    <Button x:Name="RestartListButton" Grid.Column="1" Content="Restart list" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Click="RestartListButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
