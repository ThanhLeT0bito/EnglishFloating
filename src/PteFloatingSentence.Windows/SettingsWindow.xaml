<Window x:Class="PteFloatingSentence.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PTE Floating Sentence Settings"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F172A"
        Foreground="#FFE2E8F0">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF1D4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FF475569" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF0F172A" />
            <Setter Property="Foreground" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12" Background="#FF111C32" CornerRadius="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Margin="0" HorizontalAlignment="Stretch" Content="+ New list" Click="NewListButton_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Study lists" />
                    <TextBlock Margin="0,4,0,0" Foreground="#FF94A3B8" Text="Choose the list to edit" />
                </StackPanel>
                <ListBox x:Name="StudyListList" SelectionChanged="StudyListList_SelectionChanged" />
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Padding="20" Background="#FF111C32" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="List editor" />
                        <TextBlock x:Name="ActiveListLabel" Margin="0,4,0,0" Foreground="#FF94A3B8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Make active" Click="MakeActiveButton_Click" />
                        <Button Margin="0" Background="#FFB91C1C" Content="Delete list" Click="DeleteListButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" Foreground="#FFCBD5E1" Text="List name" />
                        <TextBox x:Name="ListNameInput" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,5" Foreground="#FFCBD5E1" Text="Target" />
                        <TextBox x:Name="TargetInput" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Margin="0,0,0,6" FontWeight="SemiBold" Text="Sentences (in order)" />
                <ListBox x:Name="SentenceList" Grid.Row="3" MinHeight="120" SelectionChanged="SentenceList_SelectionChanged" />

                <Grid Grid.Row="4" Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SentenceInput" MinHeight="74" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Button Margin="0,0,0,8" Content="Add sentence" Click="AddSentenceButton_Click" />
                        <Button Margin="0,0,0,8" Background="#FF334155" Content="Update selected" Click="UpdateSentenceButton_Click" />
                        <Button Margin="0" Background="#FFB91C1C" Content="Delete selected" Click="DeleteSentenceButton_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ValidationMessage" Grid.Row="5" Margin="0,0,0,12" Foreground="#FFFCA5A5" TextWrapping="Wrap" />
                <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button IsDefault="True" Content="Save" Click="SaveButton_Click" />
                    <Button Margin="0" Background="#FF334155" Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
