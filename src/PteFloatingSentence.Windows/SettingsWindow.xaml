<Window x:Class="PteFloatingSentence.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · PTE Floating Sentence"
        Width="1020"
        Height="720"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B1120"
        Foreground="#FFE2E8F0">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF263449" />
            <Setter Property="Foreground" Value="#FFD8E2F0" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF7F1D2D" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FF475569" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF0F172A" />
            <Setter Property="Foreground" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="16" Background="#FF111827" BorderBrush="#FF263449" BorderThickness="1" CornerRadius="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Margin="0" HorizontalAlignment="Stretch" Content="＋  New study list" Click="NewListButton_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="Study lists" />
                    <TextBlock Margin="0,5,0,0" Foreground="#FF94A3B8" Text="Organize your daily practice" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox x:Name="StudyListList" SelectionChanged="StudyListList_SelectionChanged" />
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Padding="24" Background="#FF111827" BorderBrush="#FF263449" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="List editor" />
                        <TextBlock x:Name="ActiveListLabel" Margin="0,4,0,0" Foreground="#FF94A3B8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Make active" Click="MakeActiveButton_Click" />
                        <Button x:Name="DeleteListButton" Margin="0" Background="#FFB91C1C" Content="Delete list" Click="DeleteListButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" Foreground="#FFCBD5E1" Text="List name" />
                        <TextBox x:Name="ListNameInput" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,5" Foreground="#FFCBD5E1" Text="Target" />
                        <TextBox x:Name="TargetInput" />
                    </StackPanel>
                </Grid>

                    <TextBlock Grid.Row="2" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" Text="Sentences (in order)" />
                <ListBox x:Name="SentenceList" Grid.Row="3" MinHeight="120" SelectionChanged="SentenceList_SelectionChanged" />

                <Grid Grid.Row="4" Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SentenceInput" MinHeight="74" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Button Margin="0,0,0,8" Content="Add sentence" Click="AddSentenceButton_Click" />
                        <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Content="Update selected" Click="UpdateSentenceButton_Click" />
                        <Button Margin="0" Style="{StaticResource DangerButton}" Content="Delete selected" Click="DeleteSentenceButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="5" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Gemini integration · API key" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#FFCBD5E1" />
                        <PasswordBox x:Name="ApiKeyInput" Background="#FF1E293B" Foreground="#FFF8FAFC" BorderBrush="#FF475569" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <TextBlock x:Name="ApiKeyStatusLabel" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#FF94A3B8" />
                            <Button x:Name="ClearApiKeyButton" Style="{StaticResource DangerButton}" Content="Clear key" Click="ClearApiKeyButton_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ValidationMessage" Grid.Row="6" Margin="0,0,0,12" Foreground="#FFFCA5A5" TextWrapping="Wrap" />
                <StackPanel Grid.Row="7" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button IsDefault="True" Content="Save changes" Click="SaveButton_Click" />
                    <Button Margin="0" Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
