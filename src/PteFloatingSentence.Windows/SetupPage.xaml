<UserControl x:Class="PteFloatingSentence.Windows.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFE2E8F0">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="CardSubtleBrush" Color="#FF161F30" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF334155" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1D4ED8" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF059669" />
            <Setter Property="BorderBrush" Value="#FF10B981" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF7F1D2D" />
            <Setter Property="BorderBrush" Value="#4DEF4444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFCA5A5" />
        </Style>

        <Style x:Key="AiButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1A8B5CF6" />
            <Setter Property="BorderBrush" Value="#4D8B5CF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFA78BFA" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FFF8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF64748B" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="{StaticResource CardSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FF1E293B" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF475569" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FF1E293B" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF3B82F6" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Study Lists Sidebar -->
        <Border Grid.Column="0"
                Padding="10"
                Background="{StaticResource CardSubtleBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Study lists" />
                    <TextBlock FontSize="11" Margin="0,1,0,0" Foreground="{StaticResource TextMutedBrush}" Text="Organize daily practice" />
                </StackPanel>

                <ListBox x:Name="StudyListList"
                         Grid.Row="1"
                         MinHeight="100"
                         MaxHeight="360"
                         SelectionChanged="StudyListList_SelectionChanged" />

                <Button x:Name="NewListButton"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Content="＋  New study list"
                        Click="NewListButton_Click" />
            </Grid>
        </Border>

        <!-- List Editor and Sentences -->
        <Border Grid.Column="2"
                Padding="12"
                Background="{StaticResource CardSubtleBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: List Header Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="List editor" />
                        <TextBlock x:Name="ActiveListLabel" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartPracticeButton" Style="{StaticResource SuccessButton}" Content="▶  Start practice" Click="StartPracticeButton_Click" />
                        <Button x:Name="MakeActiveButton" Content="Make active" Click="MakeActiveButton_Click" />
                        <Button x:Name="DeleteListButton" Style="{StaticResource DangerButton}" Margin="0" Content="Delete list" Click="DeleteListButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: List Name and Target (Compact Inline) -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="List name:" />
                    <TextBox x:Name="ListNameInput" Grid.Column="1" Margin="0,0,14,0" Height="32" VerticalContentAlignment="Center" Padding="10,0" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="Target:" />
                    <TextBox x:Name="TargetInput" Grid.Column="3" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="6,0" />
                </Grid>

                <!-- Row 2: Sentences Header -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Sentences (in order)" />
                </Grid>

                <!-- Row 3: Sentence List (Constrained with internal scroll to keep Add box visible) -->
                <ListBox x:Name="SentenceList"
                         Grid.Row="3"
                         MinHeight="120"
                         MaxHeight="220"
                         SelectionChanged="SentenceList_SelectionChanged" />

                <!-- Row 4: Compact Sentence Editor & Add Form -->
                <Border Grid.Row="4" Margin="0,8,0,0" Padding="8" Background="#FF111827" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Sentence Input Textbox -->
                        <TextBox x:Name="SentenceInput"
                                 Grid.Row="0"
                                 MinHeight="40"
                                 MaxHeight="64"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="10,6" />

                        <!-- Action Toolbar underneath input -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Add actions (Left) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="AddSentenceButton" Content="＋ Add sentence" Click="AddSentenceButton_Click" />
                                <Button x:Name="AddWithAiButton" Style="{StaticResource AiButtonStyle}" Content="✨ AI phrased" Click="AddWithAiButton_Click" />
                            </StackPanel>

                            <!-- Selected actions (Right) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="UpdateSentenceButton" Style="{StaticResource SecondaryButton}" Content="Update selected" Click="UpdateSentenceButton_Click" />
                                <Button x:Name="DeleteSentenceButton" Style="{StaticResource DangerButton}" Margin="0" Content="Delete selected" Click="DeleteSentenceButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
